NODE_ENV=development
PORT=5000
FRONTEND_URL=

# Use the Supabase Session pooler URI; replace the placeholders.
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres
DATABASE_SSL=true

# Optional for local development; required for persistent photo storage in production.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=property-images

# Generate separate random values before deploying to production.
JWT_SECRET=replace-with-a-random-secret
APP_KEY=

LOGIN_RATE_LIMIT=20
DEMO_MODE=true
