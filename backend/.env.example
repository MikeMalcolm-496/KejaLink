

PORT=5000
NODE_ENV=development

APP_URL=http://localhost:3000
COMPANY_NAME=KejaLink Realty Solutions Ltd

DEMO_MODE=true

# --- Supabase database ---
# Supabase > Project Settings > Database > Connection string > URI (use "Session pooler")
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=true

# --- Supabase Storage (listing photos) ---
# Supabase > Project Settings > API. Leave empty to save photos in backend/uploads instead.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=property-images

# --- Secrets: generate each with ---
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
APP_KEY=

# --- E-mail: log = save to storage/mail (demo), smtp = really send ---
MAIL_MODE=log
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=KejaLink <no-reply@kejalink.co.ke>

# --- M-Pesa Daraja: simulate | sandbox | live ---
MPESA_ENV=simulate
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Public HTTPS URL Safaricom can reach, e.g. https://your-app.onrender.com/api/payments/mpesa-callback
MPESA_CALLBACK_URL=
